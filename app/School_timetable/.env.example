# Application
APP_NAME=School Timetable Generator
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,https://sanjivani.com,https://www.sanjivani.com,https://127.0.0.1,https://localhost

# Database — PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg://timetable:timetable@postgres:5432/timetable
# Local SQLite fallback for development
DATABASE_URL=sqlite:///./timetable.db

# Google Gemini — never expose these to the frontend.
# Either GEMINI_API_KEY or GOOGLE_API_KEY is accepted.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Solver
SOLVER_MAX_TIME_SECONDS=30
SOLVER_NUM_WORKERS=8

# Super admin bootstrap
BOOTSTRAP_SUPER_USERNAME=superAdmin
BOOTSTRAP_SUPER_EMAIL=superadmin@sanjivani.app
BOOTSTRAP_SUPER_PASSWORD=sanjeev@5585
PORTAL_SSO_SECRET=sanjivani-portal-sso-change-me
